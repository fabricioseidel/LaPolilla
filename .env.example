# --- Base ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_SECRET=cambia-esto-por-un-secreto-largo
# Supabase > Project Settings > Database > Connection string (Session pooler)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/lapolilla
# En producción: pooler de Supabase en modo transacción (puerto 6543)

# --- Archivos: Supabase Storage (S3) — bucket PRIVADO ---
# Supabase > Storage > S3 Connection
S3_BUCKET=polilla
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Mercado Pago (Chile, CLP) ---
# Credenciales de prueba empiezan con TEST- (usa el checkout de pruebas); producción con APP_USR-
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Lemon Squeezy (internacional, USD, merchant of record) ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Variante genérica "Libros digitales La Polilla" con precio personalizable
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Correo electrónico ---
# Se usa la primera opción configurada: 1) SMTP  2) Resend  3) consola (no se envía nada;
# en desarrollo el correo completo se muestra en la terminal).
# Remitente; se muestra como "Editorial La Polilla". Con Gmail debe ser la misma cuenta
# de SMTP_USER (o un alias verificado en Gmail); si se deja vacío, se usa SMTP_USER.
EMAIL_FROM=hola@editoriallapolilla.cl

# Opción 1: SMTP. Ejemplo con Gmail:
#   1. Activa la verificación en dos pasos en la cuenta de Google.
#   2. Crea una contraseña de aplicación en https://myaccount.google.com/apppasswords
#   3. SMTP_HOST=smtp.gmail.com · SMTP_PORT=465 · SMTP_USER=la cuenta de Gmail completa
#      SMTP_PASS=la contraseña de aplicación (16 letras; los espacios no importan)
#   Gmail tiene un límite diario de envíos: para mucho volumen conviene Resend.
# SMTP_PORT: 465 (TLS, por defecto) o 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Opción 2: Resend (https://resend.com), con el dominio del remitente verificado
RESEND_API_KEY=

# --- Boleta electrónica (opcional, ver src/lib/invoicing.ts) ---
OPENFACTURA_API_KEY=
